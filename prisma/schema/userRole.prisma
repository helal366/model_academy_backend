model UserRole {
  id                        String                        @id @default(uuid())
  role_name                 String                        @unique
  created_at                DateTime                      @default(now())
  updated_at                DateTime?                     @updatedAt
  current_management_staffs ManagementStaff[] @relation("management_current_role")
  positions                 UserPosition[]                @relation("role_position_relation")
//   created_by_id             String?
//   created_by                User?                         @relation("user_role_created_by", fields: [created_by_id], references: [id])
//   updated_by_id             String?
//   updated_by                User?                         @relation("user_role_updated_by", fields: [updated_by_id], references: [id])
  user                      User[]                        @relation("user_role_relation")

  management_staff_roles        ManagementStaff[] @relation("roles_managements")

  @@map("user_roles")
}