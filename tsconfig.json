{
  "compilerOptions": {
    "rootDir": "./", // Change from "./src" to "./" to support root config files
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "types": ["node", "express", "cookie-parser", "cors", "jsonwebtoken"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "customConditions": ["development"],
  },
  "include": ["src/**/*", "prisma7.config.ts"], // Include prisma.config.ts here
  "exclude": ["node_modules", "prisma/generated", "dist"] // Remove prisma.config.ts from here
}
